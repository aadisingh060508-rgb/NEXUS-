# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# NOTE: No service-role key is needed or used on the employee side.
# The employee-agent authenticates using the employee's own Supabase session
# (bridged from the React UI to the Node server via /api/bootstrap-session).
# The session is persisted in data/session.json and auto-restored on restart.
