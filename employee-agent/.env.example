# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: service role key allows the agent to write ACKs back without RLS blocking.
# Get it from Supabase Dashboard → Project Settings → API → service_role key.
# If omitted, the anon key is used (requires the employee_update_own_commands RLS policy).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Employee credentials — the Supabase account of the person running THIS agent.
# The server signs in with these so it can subscribe to commands addressed to it.
EMPLOYEE_EMAIL=employee@yourcompany.com
EMPLOYEE_PASSWORD=their-supabase-password
